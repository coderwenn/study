# 部署用环境变量（docker-compose 自动读取同目录的 .env）
# 复制为 .env 并填入真实值：cp .env.example .env

# JWT 签名密钥，务必改成随机串！生成命令：
#   openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-32+-byte-string

# 发布到 Wiki（可选；不填则功能关闭，端点返回 503）
# WIKI_OWNER：允许发布的用户名（笔记应用里的登录名）
WIKI_OWNER=
# 宿主机 wiki 目录属主的 uid/gid（通常 ubuntu=1000:1000）；不填则不 chown
WIKI_UID=1000
WIKI_GID=1000
