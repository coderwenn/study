# 部署用环境变量（docker-compose 自动读取同目录的 .env）
# 复制为 .env 并填入真实值：cp .env.example .env

# JWT 签名密钥，务必改成随机串！生成命令：
#   openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-32+-byte-string

# PostgreSQL 数据库
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password

# 管理后台服务间鉴权密钥（Spring Boot 调 /api/admin/* 时携带）
# 生成命令：openssl rand -hex 32
# 留空则管理后台 admin 接口不可用（返回 403）
ADMIN_API_KEY=

# 管理后台 JWT 签名密钥（Spring Boot 自己的 token，独立于 SECRET_KEY）
ADMIN_JWT_SECRET=admin-backend-secret-change-me

# 发布到 Wiki（可选；不填则功能关闭，端点返回 503）
# WIKI_OWNER：允许发布的用户名（笔记应用里的登录名）
WIKI_OWNER=
# 宿主机 wiki 目录属主的 uid/gid（通常 ubuntu=1000:1000）；不填则不 chown
WIKI_UID=1000
WIKI_GID=1000

# 网页总结（可选；LLM_* 三件全填才开启，否则功能关闭、端点返回 503）
# LLM_BASE_URL：OpenAI 兼容端点根（以 /v1 结尾，如 http://open-webui:3000/v1）
# LLM_MODEL：function-calling 能力可用的模型名
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
