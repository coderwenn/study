{
  "name": "notes-app",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "cd apps/api && uv run python -m uvicorn app.main:app --reload --port 8000",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter web build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "packageManager": "pnpm@9.0.0"
}
