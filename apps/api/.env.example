# 复制为 .env 后按需修改
# 本地开发默认 SQLite；生产环境改为 PostgreSQL：
#   DATABASE_URL=postgresql://postgres:password@db:5432/notes
DATABASE_URL=sqlite:///./notes.db
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 管理后台服务间鉴权密钥（留空则 admin 接口不可用）
ADMIN_API_KEY=

# 发布到 Wiki（本地开发用；留空则功能关闭）
WIKI_ENTRIES_PATH=
WIKI_OWNER=
WIKI_UID=0
WIKI_GID=0

# 网页总结（本地开发用；留空则功能关闭）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
